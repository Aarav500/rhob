  "cell_semantics": {
    "per_family_null": "not applicable -- no measurement exists: the family does not emit the RunData channel this detector's access level is defined over, or its horizon is shorter than the detector's min_episodes (rhob.v3.benchmark.not_applicable_reason), or the frozen model could not consume the family's version of the channel (classify raised; per_family_incompatible_runs counts the runs), or the pooled fit failed (pooled_fit_error). test_not_applicable_reasons says which. Excluded from the transfer average; never imputed as 0.5.",
    "per_family_number": "measured mean AUROC of the frozen model over that held-out family's scored difficulty cells; for a multi-trial row, the mean over model-init trials.",
    "per_family_cells": "per_family_cells_scored / per_family_cells_not_applicable: how many of a held-out family's difficulty cells its number is over and how many were not applicable (for a multi-trial row, the fewest scored and the most left out in any trial). A family scored on some cells but not all keeps the reasons for the rest in test_partial_not_applicable_reasons.",
    "train_auroc": "5-fold stratified cross-validated AUROC per train cell (Benchmark.evaluate), averaged over the scored cells -- out of fold for every row, the ensemble included (its Trajectory MLP member is refitted on each training fold).",
    "pooled_fit": "the frozen model is fitted once on the train families that pass the not-applicable rule for the detector being fitted (for the ensemble, its Trajectory MLP member); the others are listed in train_families_excluded_from_pooled_fit.",
    "null_rts": "avg_transfer_auroc(_mean) and generalization_gap_pct(_mean) are null when no held-out family was scored."
  },
