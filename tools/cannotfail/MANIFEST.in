# The sdist. setuptools already adds README.md, LICENSE, pyproject.toml, the package under
# src/ and tests/test*.py, and leaves out build/ and __pycache__; this adds the changelog and
# the examples the README runs, which the tests read too. hack_probe.py is how
# hack_probe.eval was made. A file named here also goes into the wheel if it sits inside
# src/cannotfail/, and none does: the wheel holds the package alone, which the package
# job in .github/workflows/cannotfail.yml checks on every build.
include CHANGELOG.md
include examples/scores.csv
include examples/scores.parquet
include examples/predictions.json
include examples/samples_toy_arith.jsonl
include examples/hack_probe.eval
include examples/hack_probe.py
