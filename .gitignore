# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Generated data (regenerate with scripts/generate_gridworld_data.py)
data/*.h5
results/*

# ...except the difficulty-calibration artifact, which is a published *measurement*
# rather than an intermediate: it is what the repo now cites for "does the difficulty
# knob do anything", and tests/test_v3/test_difficulty_calibration_artifact.py pins its
# headline numbers so they cannot drift out of the docs. Re-including it needs
# `results/*` above rather than `results/` -- git cannot re-include a path whose parent
# directory is itself excluded.
!results/difficulty_calibration/

# ...and the replication draws, for the same reason: leaderboard/v5_replicated.json
# reports intervals, and an interval whose underlying draws are not published is not
# checkable. These 20 files ARE the evidence that the intervals are non-degenerate.
!results/replication/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Paper source, internal planning docs, and dev/pilot scratch code are kept
# out of this repo intentionally (see CHANGELOG.md v1.3.0). Result figures
# used by the paper live in docs/figures/ and remain tracked.
/paper/
/experiments/
/docs/internal/
/.worktrees/
